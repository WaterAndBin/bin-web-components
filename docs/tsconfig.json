{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "types": ["vite/client"],
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["WebWorker"],
    "jsx": "preserve"
  },
  "exclude": ["node_modules"]
}
